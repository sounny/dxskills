{
  "manifest_version": 3,
  "name": "DxSkills - Cognitive Scaffolding",
  "version": "0.1.0",
  "description": "Transforms dense text, articles, and disordered brain dumps into high-signal D-Mode visual structures.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DxSkills Cognitive Scaffolder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
